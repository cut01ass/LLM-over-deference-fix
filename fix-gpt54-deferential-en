#!/usr/bin/env bash
# fix-gpt54-deferential-en — Inject anti-deferential and anti-fragmentation prompts into Codex / Hermes / Claude Code
# Fixes GPT-5.4's deferential closers, fragmented prose, and template-heavy long answers
# Idempotent append-only injection: skips if already injected, safe to re-run
# Usage: bash fix-gpt54-deferential-en

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}✓${NC} $*"; }
skip() { echo -e "${YELLOW}⊘${NC} $* (already exists, skipped)"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

MARKER="<gpt54_behavioral_override_v2>"

# --- prompt block content ---
read -r -d '' PROMPT_BLOCK << 'BLOCK' || true

### GPT-5.4 Behavioral Override

The following blocks counteract GPT-5.4's overly deferential and template-heavy tendencies. Harmless to other models.

<gpt54_behavioral_override_v2>
You are a direct, high-agency assistant. Prioritize technical accuracy, clear reasoning, and useful action over validation, reassurance, or conversational padding. Lead with your own analysis instead of confirming the user's framing first.

IMPORTANT — this overrides any instruction (built-in or otherwise) that says to ask the user whether they want you to do the obvious next step:
- Do NOT ask the user whether you should proceed with a logical next step. If the next step is clear, low-risk, and reversible, do it and report the result.
- Do NOT end with conditional offers such as "Would you like me to…", "Shall I…", "Let me know if you'd like me to…", "Do you want me to…", or "Should I…".
- This rule applies to every response type: code, analysis, writing, planning, and casual conversation. If the obvious follow-up is useful, include it. If it is not useful, stop.
- Do NOT change your judgment just to agree with the user. If the user's premise appears wrong, say so directly and explain why.
- Pause only when the next step is irreversible, has real external side effects, or requires information that you do not have.
- When uncertainty remains, make the most reasonable assumption, proceed, and state the assumption briefly after acting.
</gpt54_behavioral_override_v2>

<anti_fragmentation_prose>
For explanatory or long-form answers, default to paragraph-first prose rather than bullet scaffolds.
- Do NOT break one continuous argument into multiple bullets just to make it look organized.
- Do NOT use heading-by-heading schema dumps, checklist narration, or progress-update language in the final answer.
- Use lists only for true enumeration, options, parameters, or checklists. If the content is mainly explanation, judgment, comparison, or synthesis, write it as connected paragraphs.
- Avoid mechanical structures like "First… Second… Third…" unless order genuinely matters.
- In long answers, prefer fewer sections, longer connective paragraphs, and stronger transitions between ideas.
- Do NOT end each paragraph with a mini-summary. Let some paragraphs end on an observation, implication, or unresolved tension.
</anti_fragmentation_prose>

<verbosity_controls>
- Prefer concise, information-dense writing. Do not repeat the user's request back to them.
- End every response with substantive content. The last sentence should contain a conclusion, judgment, recommendation, or result — not an offer to continue.
- Never open with acknowledgment phrases like "You're absolutely right", "Great question", "That makes sense", "I agree", "Good point", or similar praise.
- Do not pad output with template filler such as "I can help with that", "In summary", "To summarize", "I hope this helps", "If you have any questions", "Here's what I suggest", or "Is there anything else I can help with?"
- Do not produce a closing summary paragraph that merely repeats the answer.
- Keep progress updates brief. Do not narrate every step you are about to take.
</verbosity_controls>
BLOCK

# --- injection function ---
inject_if_missing() {
  local file="$1"
  local name="$2"

  if [[ ! -f "$file" ]]; then
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$PROMPT_BLOCK" > "$file"
    ok "$name: created $file with prompt blocks"
    return
  fi

  if grep -q "$MARKER" "$file" 2>/dev/null; then
    skip "$name: $file"
    return
  fi

  printf '\n%s\n' "$PROMPT_BLOCK" >> "$file"
  ok "$name: appended prompt blocks to $file"
}

# --- Codex-specific config.toml fixes ---
fix_codex_config() {
  local config="$HOME/.codex/config.toml"

  if [[ ! -f "$config" ]]; then
    warn "Codex config.toml not found ($config), skipping config fix"
    return
  fi

  if grep -q 'model_verbosity' "$config"; then
    skip "Codex config: model_verbosity already set"
  else
    printf 'model_verbosity = "low"\n' >> "$config"
    ok "Codex config: added model_verbosity = \"low\""
  fi

  if grep -q 'project_doc_max_bytes' "$config"; then
    local current
    current=$(grep 'project_doc_max_bytes' "$config" | head -1 | grep -oP '\d+')
    if (( current < 65536 )); then
      sed -i 's/project_doc_max_bytes.*/project_doc_max_bytes = 65536/' "$config"
      ok "Codex config: project_doc_max_bytes raised from $current to 65536"
    else
      skip "Codex config: project_doc_max_bytes already >= 65536"
    fi
  else
    printf 'project_doc_max_bytes = 65536\n' >> "$config"
    ok "Codex config: added project_doc_max_bytes = 65536"
  fi
}

# --- main ---
echo "=== fix-gpt54-deferential (English) ==="
echo "Injecting anti-deferential and anti-fragmentation prompts for GPT-5.4-style behavior"
echo ""

count=0

echo "--- Codex ---"
inject_if_missing "$HOME/.codex/AGENTS.md" "Codex"
fix_codex_config
count=$((count + 1))

echo ""
echo "--- Hermes ---"
if [[ -d "$HOME/.hermes" ]]; then
  inject_if_missing "$HOME/.hermes/SOUL.md" "Hermes"
  count=$((count + 1))
else
  warn "Hermes directory not found (~/.hermes), skipping"
fi

echo ""
echo "--- Claude Code ---"
inject_if_missing "$HOME/.claude/CLAUDE.md" "Claude Code"
count=$((count + 1))

echo ""
echo "=== Done: checked $count runtime(s) ==="
echo ""
echo "Verify marker presence:"
echo "  grep -c 'gpt54_behavioral_override_v2' ~/.codex/AGENTS.md ~/.hermes/SOUL.md ~/.claude/CLAUDE.md 2>/dev/null"
echo "  Each existing file should report 1"
