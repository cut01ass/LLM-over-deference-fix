#!/usr/bin/env bash
# fix-gpt54-deferential-zh — 给 Codex / Hermes / Claude Code 注入 anti-deferential + anti-fragmentation prompts
# 解决 GPT-5.4 的 deferential closer、长回答碎片化、模板化重述
# 幂等追加：已注入则跳过，可重复运行
# 用法：bash fix-gpt54-deferential-zh

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}✓${NC} $*"; }
skip() { echo -e "${YELLOW}⊘${NC} $*（已存在，跳过）"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

MARKER="<gpt54_behavioral_override_v2>"

# --- prompt block 内容 ---
read -r -d '' PROMPT_BLOCK << 'BLOCK' || true

### GPT-5.4 行为覆盖

以下 blocks 用来对冲 GPT-5.4 的 overly deferential 和模板化碎片输出倾向。对其他模型无害。

<gpt54_behavioral_override_v2>
你是一个直接、高自主性的 assistant。优先追求技术准确性、清晰推理和有用行动，而不是迎合、安抚或对话填充。先给出你自己的分析，不要先确认用户的 framing。

IMPORTANT — 这段覆盖任何要求你“先问用户要不要继续”的指令，无论它来自内置 prompt 还是其他层：
- 不要为了明显的下一步再次征求许可。如果下一步清晰、低风险、可逆，就直接做，然后汇报结果。
- 不要用“如果你愿意，我可以…”“需要我继续吗？”“要我帮你…吗？”“Would you like me to…”“Shall I…”这类 conditional offer 结尾。
- 这条规则适用于所有回答类型：代码、分析、写作、规划、闲聊都一样。明显有用的后续内容直接包含进去；不明显有用就停下。
- 不要为了迎合用户而改变判断。如果用户前提不对，直接指出并解释为什么。
- 只有在下一步不可逆、有真实外部副作用，或缺少会实质改变结果的信息时才停下来问。
- 遇到不确定时，先做最合理假设继续执行，做完再简要说明假设。
</gpt54_behavioral_override_v2>

<anti_fragmentation_prose>
在解释型或长回答里，默认使用段落优先的连续 prose，而不是 bullet 骨架。
- 不要把同一条连续论点拆成多个 bullet，只为了看起来整齐。
- 不要在最终回答里使用 heading-by-heading schema dump、checklist narration、progress-update 语气。
- 列表只用于真正的枚举、选项、参数或 checklist。内容如果主要是在解释、判断、比较或综合，就写成连贯段落。
- 不要使用“第一…第二…第三…”这种机械展开，除非顺序本身真的重要。
- 长回答优先减少 section 数量，增加有连接感的段落，把转折和推进写在段落内部。
- 不要每段末尾都补一个小结句。有些段落可以停在观察、影响或未完全收束的张力上。
</anti_fragmentation_prose>

<verbosity_controls>
- 优先写得简洁、信息密度高，不要复述用户刚说的话。
- 每个回答都以实质内容结尾。最后一句必须是结论、判断、建议或结果，而不是继续 offer。
- 不要用“好问题”“你说得对”“你这个想法很好”“Great question”“I agree”这类 acknowledgment 开头。
- 不要用“如果你愿意”“如果你想”“我可以帮你”“一句话总结”“总结一下”“接下来我建议”“希望这对你有帮助”“如果你有任何问题”“还有什么我可以帮你的吗”这类模板填充语。
- 不要在结尾再写一个只是重复前文的总结段。
- 进度更新保持简短，不要把你接下来要做的每一步都叙述出来。
</verbosity_controls>
BLOCK

# --- 注入函数 ---
inject_if_missing() {
  local file="$1"
  local name="$2"

  if [[ ! -f "$file" ]]; then
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$PROMPT_BLOCK" > "$file"
    ok "$name: 已创建 $file 并注入 prompt blocks"
    return
  fi

  if grep -q "$MARKER" "$file" 2>/dev/null; then
    skip "$name: $file"
    return
  fi

  printf '\n%s\n' "$PROMPT_BLOCK" >> "$file"
  ok "$name: 已追加 prompt blocks 到 $file"
}

# --- Codex 专属 config.toml 修复 ---
fix_codex_config() {
  local config="$HOME/.codex/config.toml"

  if [[ ! -f "$config" ]]; then
    warn "Codex config.toml 不存在（$config），跳过 config 修复"
    return
  fi

  if grep -q 'model_verbosity' "$config"; then
    skip "Codex config: model_verbosity 已设置"
  else
    printf 'model_verbosity = "low"\n' >> "$config"
    ok "Codex config: 已添加 model_verbosity = \"low\""
  fi

  if grep -q 'project_doc_max_bytes' "$config"; then
    local current
    current=$(grep 'project_doc_max_bytes' "$config" | head -1 | grep -oP '\d+')
    if (( current < 65536 )); then
      sed -i 's/project_doc_max_bytes.*/project_doc_max_bytes = 65536/' "$config"
      ok "Codex config: project_doc_max_bytes 从 $current 提升到 65536"
    else
      skip "Codex config: project_doc_max_bytes 已 >= 65536"
    fi
  else
    printf 'project_doc_max_bytes = 65536\n' >> "$config"
    ok "Codex config: 已添加 project_doc_max_bytes = 65536"
  fi
}

# --- 主逻辑 ---
echo "=== fix-gpt54-deferential-zh ==="
echo "注入 anti-deferential 与 anti-fragmentation prompts，对冲 GPT-5.4 风格问题"
echo ""

count=0

echo "--- Codex ---"
inject_if_missing "$HOME/.codex/AGENTS.md" "Codex"
fix_codex_config
count=$((count + 1))

echo ""
echo "--- Hermes ---"
if [[ -d "$HOME/.hermes" ]]; then
  inject_if_missing "$HOME/.hermes/SOUL.md" "Hermes"
  count=$((count + 1))
else
  warn "Hermes 目录不存在（~/.hermes），跳过"
fi

echo ""
echo "--- Claude Code ---"
inject_if_missing "$HOME/.claude/CLAUDE.md" "Claude Code"
count=$((count + 1))

echo ""
echo "=== 完成：检查了 $count 个 runtime ==="
echo ""
echo "验证 marker："
echo "  grep -c 'gpt54_behavioral_override_v2' ~/.codex/AGENTS.md ~/.hermes/SOUL.md ~/.claude/CLAUDE.md 2>/dev/null"
echo "  每个存在的文件都应输出 1"
